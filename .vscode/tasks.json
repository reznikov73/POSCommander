{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "POSCommander: Build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "POSCommander: Run",
      "type": "npm",
      "script": "start",
      "problemMatcher": []
    },
    {
      "label": "POSCommander: Build EXE and installer",
      "type": "npm",
      "script": "build:exe",
      "problemMatcher": []
    },
    {
      "label": "POSCommander: Install dependencies",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    }
  ]
}
