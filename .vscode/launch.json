{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "POSCommander: Electron main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "args": ["."],
      "preLaunchTask": "POSCommander: Build",
      "outputCapture": "std",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "POSCommander: Attach renderer (start main first)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
